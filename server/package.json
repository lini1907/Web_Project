{
  "name": "farmtable-server",
  "version": "2.0.0",
  "private": true,
  "description": "FarmTable v2 REST API (Node.js + Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db": "node scripts/local-db.js",
    "seed": "node src/seed/seed.js",
    "media": "node scripts/prepare-storefront-media.mjs",
    "fonts": "node scripts/prepare-storefront-fonts.mjs",
    "farm-media": "node scripts/prepare-farm-media.mjs",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "bench": "node scripts/bench.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.4",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2"
  }
}
