# Sao chép thành .env rồi chỉnh. KHÔNG commit file .env thật.
PORT=3000
NODE_ENV=development
# MongoDB phải chạy replica set (hoặc Atlas) để dùng transaction.
# Không cài MongoDB? Chạy `npm run db` (replica set cục bộ, dữ liệu ở server/.data/db).
MONGODB_URI=mongodb://127.0.0.1:27017/farmtable?replicaSet=rs0
SESSION_SECRET=doi-chuoi-bi-mat-dai-it-nhat-32-ky-tu
SESSION_MAX_AGE_HOURS=8
# Dịch vụ gợi ý (Python). Tắt dịch vụ này thì API tự trả kết quả phương pháp cơ sở.
ML_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1500
# Chu kỳ worker đóng chiến dịch mua chung (ms)
GROUPBUY_WORKER_MS=60000
# Thư mục bản build Angular để Express phục vụ khi demo (npm run build ở client)
CLIENT_DIST=../client/dist/client/browser
# Mật khẩu chung cho tài khoản demo khi seed (chỉ dùng cho môi trường demo)
SEED_DEMO_PASSWORD=FarmTable@2026
# Gửi email (quên mật khẩu). Để trống SMTP_HOST thì mã OTP chỉ in ra console server.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASS=<App Password 16 ký tự>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FarmTable <no-reply@farmtable.vn>
# Địa chỉ công khai của server (dùng làm Return/IPN URL cho cổng thanh toán và redirect URI của Google)
PUBLIC_URL=http://localhost:3000
# Địa chỉ giao diện Angular (khi chạy ng serve: http://localhost:4200). Để trống = PUBLIC_URL
APP_URL=
# VNPay Sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận TMN code + Hash secret
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# MoMo Test: lấy partner code / access key / secret key tại https://developers.momo.vn (môi trường test)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Google OAuth 2.0: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chatbot tư vấn (Google Gemini): tạo key tại https://aistudio.google.com/apikey. Để trống = ẩn khung chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
